# SWF implementation version. It is compared in the provider election, so bump it with
# every release: the newest copy installed anywhere in the load order hooks the engine.
set(SWF_VERSION_MAJOR 0)
set(SWF_VERSION_MINOR 1)
set(SWF_VERSION_PATCH 0)
set(SWF_VERSION_BUILD 0)
set(SWF_VERSION "${SWF_VERSION_MAJOR}.${SWF_VERSION_MINOR}.${SWF_VERSION_PATCH}")
